# Which model powers aiMaestro. Format: provider:model
AIMAESTRO_MODEL=google_genai:gemini-2.5-flash

# Set the key matching the provider above.
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: keep separate memory profiles in one database
AIMAESTRO_USER_ID=default-user

# Optional: where memory lives
AIMAESTRO_DB_PATH=data/aimaestro.db
